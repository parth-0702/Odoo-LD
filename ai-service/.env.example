# Port the AI service listens on
PORT=5001

# Environment: development | production
NODE_ENV=development

# Google Gemini Developer API key (from https://aistudio.google.com/apikey)
# Get your own key locally — never commit a real value here.
GEMINI_API_KEY=

# Gemini model to use. Optional — falls back to a sensible default
# (see src/providers/gemini.provider.js) if left blank.
GEMINI_MODEL=
